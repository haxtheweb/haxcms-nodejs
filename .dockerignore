# Security (review 2026-10): `COPY . .` must never bake developer secrets into
# the image. app.js loads .env via dotenv at startup, so a .env in the build
# context would ship (and take effect) in every container built from it.
.env
.env.*
**/.env
**/.env.*
# runtime secrets that land in the boilerplate folder when ~/.haxcmsconfig
# cannot be created (discoverConfigPath.js fallback) — see .gitignore
src/boilerplate/systemsetup/.pk
src/boilerplate/systemsetup/.rpk
src/boilerplate/systemsetup/.user
src/boilerplate/systemsetup/SALT.txt
src/boilerplate/systemsetup/INITIAL_ADMIN_PASSWORD.txt
.haxcmsconfig

# not needed to build or run the image (the build only runs `babel src`)
.github
.vscode
.devcontainer
