# Managed by HAXcms. Prevent execution of uploaded scripts in /files.
Options -ExecCGI
<IfModule mod_authz_core.c>
  <FilesMatch "\.(php[0-9]?|phtml|phar|pl|py|cgi|asp|aspx|jsp|sh|bash)$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "\.(php[0-9]?|phtml|phar|pl|py|cgi|asp|aspx|jsp|sh|bash)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>
# Security (SEC-DEPLOY): files.json is the server's index of this site's
# uploads, read and written by the backend only; the site API serves it to
# signed-in editors (GET v1/files). It is never served as a static file.
<Files "files.json">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>
# Security (SEC-UPLOAD): uploaded browser-renderable markup (html, htm, xhtml,
# xml, svg; case-insensitive, same list as the HAXcms root .htaccess and
# haxcms-nodejs) is always downloaded, never rendered inline in the site
# origin, and carries Content-Security-Policy: sandbox. FilesMatch tests the name of the file actually being served from
# this directory tree, so URL encodings (x%2ehtml, %66iles/) cannot bypass it,
# and it still applies when the site is served from its own vhost/docroot
# where the HAXcms root .htaccess is not a parent directory.
<IfModule mod_headers.c>
  <FilesMatch "(?i)\.(html?|xhtml|xml|svg)$">
    Header always set Content-Disposition "attachment"
    Header always set X-Content-Type-Options nosniff
    # if it is ever rendered inline anyway, it runs in an opaque origin with
    # scripts off and no access to the site's sessions or data
    Header always append Content-Security-Policy "sandbox"
  </FilesMatch>
</IfModule>
# Uploaded content encoding is not guaranteed; don't inherit the UTF-8
# charset tagging applied at the site root to generated/managed files.
<IfModule mod_mime.c>
  RemoveCharset .txt .md .json .yaml .yml .xml
</IfModule>
